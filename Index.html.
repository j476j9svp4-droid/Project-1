<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Демо Лендинг — Swill Way</title>
<meta name="description" content="Универсальный адаптивный демо-лендинг: услуги, о нас, отзывы, контакты.">
<style>
  :root{
    --bg:#0b0f14;
    --bg-soft:#111823;
    --card:#16202c;
    --text:#e8eef5;
    --muted:#9aa8b6;
    --accent:#3ea6ff;
    --accent-2:#7c5cff;
    --border:#243244;
    --radius:16px;
    --max:1160px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Inter,Arial,sans-serif;
    background:var(--bg);color:var(--text);line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }
  a{color:inherit;text-decoration:none}
  img{max-width:100%;display:block}
  .container{max-width:var(--max);margin:0 auto;padding:0 20px}
  .section-soft{background:var(--bg-soft)}
  .h2-tight{font-size:clamp(1.6rem,3vw,2.2rem);margin-bottom:14px;letter-spacing:-.5px}

  /* Header */
  header{
    position:sticky;top:0;z-index:50;
    background:rgba(11,15,20,.85);
    -webkit-backdrop-filter:blur(10px);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--border);
  }
  .nav{display:flex;align-items:center;justify-content:space-between;height:68px}
  .logo{font-weight:800;font-size:1.25rem;letter-spacing:.5px;display:inline-block}
  .logo span{background:linear-gradient(90deg,var(--accent),var(--accent-2));-webkit-background-clip:text;background-clip:text;color:transparent}
  .nav-links{display:flex;gap:28px;list-style:none}
  .nav-links a{color:var(--muted);font-size:.95rem;transition:color .2s}
  .nav-links a:hover{color:var(--text)}
  .burger{display:none;background:none;border:none;color:var(--text);font-size:1.6rem;cursor:pointer;padding:6px 10px;border-radius:8px}
  .burger:focus-visible{outline:2px solid var(--accent);outline-offset:2px}

  /* Hero */
  .hero{
    padding:90px 0 80px;
    background:
      radial-gradient(900px 400px at 80% -10%, rgba(124,92,255,.25), transparent 60%),
      radial-gradient(700px 350px at 10% 10%, rgba(62,166,255,.18), transparent 60%);
  }
  .hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:center}
  .badge{
    display:inline-block;padding:6px 14px;border:1px solid var(--border);
    border-radius:999px;font-size:.8rem;color:var(--muted);margin-bottom:20px;
  }
  .hero h1{font-size:clamp(2rem,4.5vw,3.4rem);line-height:1.1;letter-spacing:-1px;margin-bottom:18px}
  .hero h1 span{background:linear-gradient(90deg,var(--accent),var(--accent-2));-webkit-background-clip:text;background-clip:text;color:transparent}
  .hero p{color:var(--muted);font-size:1.1rem;max-width:520px;margin-bottom:30px}
  .btn{
    display:inline-block;padding:14px 26px;border-radius:12px;font-weight:600;font-size:.98rem;
    transition:transform .15s, box-shadow .2s;cursor:pointer;border:none;
  }
  .btn:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  .btn-primary{background:linear-gradient(90deg,var(--accent),var(--accent-2));color:#fff;box-shadow:0 8px 24px rgba(62,166,255,.25)}
  .btn-primary:hover{transform:translateY(-2px);box-shadow:0 12px 30px rgba(62,166,255,.35)}
  .btn-ghost{background:transparent;border:1px solid var(--border);color:var(--text);margin-left:12px}
  .btn-ghost:hover{border-color:var(--accent)}
  .hero-card{
    background:var(--card);border:1px solid var(--border);border-radius:var(--radius);
    padding:26px;box-shadow:0 20px 50px rgba(0,0,0,.35);
  }
  .hero-card h3{font-size:1rem;color:var(--muted);font-weight:500;margin-bottom:16px}
  .stat{display:flex;justify-content:space-between;padding:14px 0;border-bottom:1px solid var(--border)}
  .stat:last-child{border-bottom:none}
  .stat b{font-size:1.3rem}
  .stat span{color:var(--muted);font-size:.9rem}

  /* Sections */
  section{padding:80px 0}
  .section-head{text-align:center;max-width:640px;margin:0 auto 50px}
  .section-head h2{font-size:clamp(1.6rem,3vw,2.3rem);margin-bottom:12px;letter-spacing:-.5px}
  .section-head p{color:var(--muted)}

  /* Services */
  .grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
  .card{
    background:var(--bg-soft);border:1px solid var(--border);border-radius:var(--radius);
    padding:28px;transition:transform .2s, border-color .2s;
  }
  .card:hover{transform:translateY(-4px);border-color:var(--accent)}
  .card .ico{
    width:48px;height:48px;border-radius:12px;display:grid;place-items:center;
    background:linear-gradient(135deg,rgba(62,166,255,.2),rgba(124,92,255,.2));
    font-size:1.4rem;margin-bottom:18px;
  }
  .card h3{font-size:1.15rem;margin-bottom:10px}
  .card p{color:var(--muted);font-size:.95rem}

  /* About */
  .about-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}
  .about-grid h2{font-size:clamp(1.6rem,3vw,2.2rem);margin-bottom:18px;letter-spacing:-.5px}
  .about-grid p{color:var(--muted);margin-bottom:16px}
  .checks{list-style:none;margin-top:20px}
  .checks li{padding:10px 0 10px 32px;position:relative;color:var(--text)}
  .checks li::before{
    content:"✓";position:absolute;left:0;top:10px;width:22px;height:22px;border-radius:50%;
    background:rgba(62,166,255,.15);color:var(--accent);display:grid;place-items:center;font-size:.8rem;
  }
  .visual{
    aspect-ratio:4/3;border-radius:var(--radius);border:1px solid var(--border);
    background:
      radial-gradient(300px 200px at 30% 30%, rgba(62,166,255,.25), transparent 70%),
      radial-gradient(300px 200px at 70% 70%, rgba(124,92,255,.25), transparent 70%),
      var(--bg-soft);
    display:grid;place-items:center;color:var(--muted);font-size:.9rem;text-align:center;padding:20px;
  }

  /* Reviews */
  .reviews .card p{font-style:italic;margin-bottom:18px}
  .author{display:flex;align-items:center;gap:12px}
  .avatar{
    width:42px;height:42px;border-radius:50%;
    background:linear-gradient(135deg,var(--accent),var(--accent-2));
    display:grid;place-items:center;font-weight:700;color:#fff;flex-shrink:0;
  }
  .author b{display:block;font-size:.95rem}
  .author span{color:var(--muted);font-size:.82rem}

  /* Contact */
  .contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px}
  .contact-form{display:flex;flex-direction:column;gap:16px}
  .field label{display:block;font-size:.85rem;color:var(--muted);margin-bottom:6px}
  .field input,.field textarea{
    width:100%;padding:13px 15px;border-radius:12px;border:1px solid var(--border);
    background:var(--bg-soft);color:var(--text);font-family:inherit;font-size:.95rem;
    transition:border-color .2s;
  }
  .field input:focus,.field textarea:focus{outline:none;border-color:var(--accent)}
  .field textarea{resize:vertical;min-height:120px}
  .form-note{font-size:.8rem;color:var(--muted)}
  .form-msg{font-size:.9rem;color:var(--accent);min-height:1.2em}
  .contact-info p{color:var(--muted);margin-bottom:22px}
  .info-row{display:flex;gap:14px;padding:14px 0;border-bottom:1px solid var(--border)}
  .info-row:last-child{border-bottom:none}
  .info-row .ico{font-size:1.2rem}
  .info-row b{display:block;font-size:.92rem}
  .info-row span{color:var(--muted);font-size:.9rem}

  /* Footer */
  footer{border-top:1px solid var(--border);padding:34px 0;background:var(--bg-soft)}
  .foot{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px}
  .foot p{color:var(--muted);font-size:.88rem}
  .foot-links{display:flex;gap:22px}
  .foot-links a{color:var(--muted);font-size:.88rem;transition:color .2s}
  .foot-links a:hover{color:var(--text)}

  /* Responsive */
  @media (max-width:900px){
    .hero-grid,.about-grid,.contact-grid{grid-template-columns:1fr}
    .grid-3{grid-template-columns:1fr}
    .nav-links{
      position:absolute;top:68px;left:0;right:0;background:var(--bg-soft);
      flex-direction:column;gap:0;padding:12px 20px;border-bottom:1px solid var(--border);
      display:none;
    }
    .nav-links.open{display:flex}
    .nav-links li{padding:12px 0;border-bottom:1px solid var(--border)}
    .nav-links li:last-child{border-bottom:none}
    .burger{display:block}
    .btn-ghost{margin-left:0;margin-top:12px}
  }
</style>
</head>
<body>

<!-- HEADER -->
<header>
  <div class="container nav">
    <a href="#" class="logo" aria-label="На главную">SWILL<span>WAY</span></a>
    <ul class="nav-links" id="navLinks">
      <li><a href="#services">Услуги</a></li>
      <li><a href="#about">О нас</a></li>
      <li><a href="#reviews">Отзывы</a></li>
      <li><a href="#contact">Контакты</a></li>
    </ul>
    <button class="burger" id="burger" aria-label="Открыть меню" aria-expanded="false" aria-controls="navLinks">☰</button>
  </div>
</header>

<!-- HERO -->
<section class="hero">
  <div class="container hero-grid">
    <div>
      <span class="badge">Демо-лендинг · готов к запуску</span>
      <h1>Делаем <span>цифровые продукты</span>, которые работают</h1>
      <p>Универсальный адаптивный одностраничник: чистый код, быстрая загрузка, форма обратной связи, мобильная версия. Замените тексты — и сайт готов для вашего бизнеса.</p>
      <a href="#contact" class="btn btn-primary">Оставить заявку</a>
      <a href="#services" class="btn btn-ghost">Наши услуги</a>
    </div>
    <div class="hero-card">
      <h3>Показатели за квартал</h3>
      <div class="stat"><b>120+</b><span>проектов</span></div>
      <div class="stat"><b>98%</b><span>довольных клиентов</span></div>
      <div class="stat"><b>24/7</b><span>поддержка</span></div>
    </div>
  </div>
</section>

<!-- SERVICES -->
<section id="services">
  <div class="container">
    <div class="section-head">
      <h2>Что мы делаем</h2>
      <p>Три направления, которые закрывают основные задачи цифрового присутствия.</p>
    </div>
    <div class="grid-3">
      <div class="card">
        <div class="ico">🚀</div>
        <h3>Лендинги и сайты</h3>
        <p>Быстрые адаптивные страницы под запуск продукта, акцию или презентацию компании.</p>
      </div>
      <div class="card">
        <div class="ico">⚙️</div>
        <h3>Веб-разработка</h3>
        <p>Фронтенд и бэкенд, интеграции, формы, личные кабинеты, автоматизация процессов.</p>
      </div>
      <div class="card">
        <div class="ico">📈</div>
        <h3>Аналитика и рост</h3>
        <p>Подключение метрик, A/B-тесты, оптимизация конверсии и скорости загрузки.</p>
      </div>
    </div>
  </div>
</section>

<!-- ABOUT -->
<section id="about" class="section-soft">
  <div class="container about-grid">
    <div>
      <h2>О нас</h2>
      <p>Мы — команда Swill Way. Делаем сайты и цифровые продукты с 2025 года. Работаем прозрачно: фиксируем этапы, показываем промежуточные результаты, сдаём в срок.</p>
      <p>Этот лендинг — демонстрация подхода: минимум лишнего, максимум скорости и понятная структура.</p>
      <ul class="checks">
        <li>Адаптивность под все экраны</li>
        <li>Чистый код без лишних зависимостей</li>
        <li>Форма обратной связи из коробки</li>
        <li>Готовность к SEO и аналитике</li>
      </ul>
    </div>
    <div class="visual">Визуальный блок — замените на изображение или видео</div>
  </div>
</section>

<!-- REVIEWS -->
<section id="reviews" class="reviews">
  <div class="container">
    <div class="section-head">
      <h2>Отзывы</h2>
      <p>Что говорят клиенты о работе с нами.</p>
    </div>
    <div class="grid-3">
      <div class="card">
        <p>«Сайт собрали за неделю, всё чётко по ТЗ. Конверсия выросла уже в первый месяц.»</p>
        <div class="author">
          <div class="avatar">А</div>
          <div><b>Алексей</b><span>Основатель студии</span></div>
        </div>
      </div>
      <div class="card">
        <p>«Понравился подход: показали прототип, дали потрогать, потом доделали детали.»</p>
        <div class="author">
          <div class="avatar">М</div>
          <div><b>Марина</b><span>Маркетолог</span></div>
        </div>
      </div>
      <div class="card">
        <p>«Форма заявок работает, менеджеры получают письма мгновенно. Всё стабильно.»</p>
        <div class="author">
          <div class="avatar">Д</div>
          <div><b>Дмитрий</b><span>Руководитель продаж</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CONTACT -->
<section id="contact" class="section-soft">
  <div class="container contact-grid">
    <div>
      <h2 class="h2-tight">Свяжитесь с нами</h2>
      <p>Оставьте заявку — ответим в течение рабочего дня. Или напишите напрямую.</p>
      <div class="info-row"><div class="ico">✉️</div><div><b>Email</b><span>hello@example.com</span></div></div>
      <div class="info-row"><div class="ico">📞</div><div><b>Телефон</b><span>+375 (00) 000-00-00</span></div></div>
      <div class="info-row"><div class="ico">📍</div><div><b>Адрес</b><span>Молодечно, Беларусь</span></div></div>
    </div>
    <form class="contact-form" id="contactForm" novalidate>
      <div class="field">
        <label for="name">Имя</label>
        <input type="text" id="name" name="name" placeholder="Как к вам обращаться" required>
      </div>
      <div class="field">
        <label for="email">Email или телефон</label>
        <input type="text" id="email" name="email" placeholder="Для связи" required>
      </div>
      <div class="field">
        <label for="message">Сообщение</label>
        <textarea id="message" name="message" placeholder="Кратко опишите задачу" required></textarea>
      </div>
      <button type="submit" class="btn btn-primary" style="align-self:flex-start">Отправить</button>
      <div class="form-msg" id="formMsg" role="status" aria-live="polite"></div>
      <p class="form-note">Демо-форма: данные не отправляются на сервер. Для реальной отправки подключите бэкенд или сервис форм.</p>
    </form>
  </div>
</section>

<!-- FOOTER -->
<footer>
  <div class="container foot">
    <p>© 2026 SWILLWAY. Демо-лендинг.</p>
    <div class="foot-links">
      <a href="#services">Услуги</a>
      <a href="#about">О нас</a>
      <a href="#contact">Контакты</a>
    </div>
  </div>
</footer>

<script>
  (function () {
    'use strict';

    // Мобильное меню
    var burger = document.getElementById('burger');
    var navLinks = document.getElementById('navLinks');

    if (burger && navLinks) {
      burger.addEventListener('click', function () {
        var open = navLinks.classList.toggle('open');
        burger.setAttribute('aria-expanded', open ? 'true' : 'false');
        burger.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
      });

      navLinks.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function () {
          navLinks.classList.remove('open');
          burger.setAttribute('aria-expanded', 'false');
          burger.setAttribute('aria-label', 'Открыть меню');
        });
      });
    }

    // Демо-обработка формы
    var form = document.getElementById('contactForm');
    var formMsg = document.getElementById('formMsg');

    if (form && formMsg) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();

        var nameEl = form.elements.namedItem('name');
        var emailEl = form.elements.namedItem('email');
        var messageEl = form.elements.namedItem('message');

        if (!nameEl || !emailEl || !messageEl) return;

        var name = nameEl.value.trim();
        var contact = emailEl.value.trim();
        var message = messageEl.value.trim();

        if (!name || !contact || !message) {
          formMsg.style.color = '#ff6b6b';
          formMsg.textContent = 'Заполните все поля.';
          return;
        }

        formMsg.style.color = '#3ea6ff';
        formMsg.textContent = 'Заявка принята (демо). Спасибо, ' + name + '!';
        form.reset();
      });
    }
  })();
</script>
</body>
</html>